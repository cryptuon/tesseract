# Tesseract Demo Deployment - Environment Variables

# ========================================
# REQUIRED - Must be set before deployment
# ========================================

# Relayer wallet private key (hex format, with or without 0x prefix)
# This wallet needs Sepolia ETH for gas fees
# Get test ETH from: https://sepoliafaucet.com
RELAYER_PRIVATE_KEY=

# Deployed contract addresses on Sepolia
# Deploy using: uv run python scripts/deploy_simple.py sepolia
TESSERACT_BUFFER_ADDRESS=
COORDINATOR_ADDRESS=

# ========================================
# OPTIONAL - Have sensible defaults
# ========================================

# PostgreSQL password (default: tesseract)
POSTGRES_PASSWORD=tesseract

# Site URL for SEO (default: https://tesseract.io)
SITE_URL=https://tesseract.io

# ========================================
# Build-time variables (set in Dockerfile)
# ========================================

# API URL path for frontend (proxied through nginx)
# PUBLIC_API_URL=/api
