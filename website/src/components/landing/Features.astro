---
// Features section with 6 cards - GEO optimized with question-based headers

const features = [
  {
    title: "What is MEV Protection?",
    description: "Tesseract uses a commit-reveal scheme that hides your transaction details until after commitment is on-chain. MEV bots cannot front-run or sandwich attack your swaps.",
    icon: "shield",
    color: "primary",
  },
  {
    title: "How Does Flash Loan Resistance Work?",
    description: "A 2-block minimum delay between buffering and resolution makes flash loan attacks economically infeasible. Attackers cannot manipulate state within a single block.",
    icon: "lock",
    color: "secondary",
  },
  {
    title: "What Are Atomic Swap Groups?",
    description: "Execute up to 4 swap legs atomically across chains. If any leg fails, all legs revert. Perfect for complex arbitrage and multi-hop routing strategies.",
    icon: "link",
    color: "primary",
  },
  {
    title: "Which Networks Are Supported?",
    description: "Swap across Ethereum, Polygon, Arbitrum, Optimism, and Base. All networks use identical contracts for consistent security and behavior.",
    icon: "globe",
    color: "secondary",
  },
  {
    title: "How Do Staking Rewards Work?",
    description: "Stake TESS tokens to earn 60% of protocol fees. Non-dilutive rewards paid in actual swap tokens (ETH, USDC, etc.), not inflationary TESS emissions.",
    icon: "coins",
    color: "primary",
  },
  {
    title: "What Governance Rights Exist?",
    description: "TESS holders can propose and vote on protocol changes. 100k TESS to propose, 4% quorum required. 7-day voting with 2-day timelock before execution.",
    icon: "vote",
    color: "secondary",
  },
];

const iconPaths: Record<string, string> = {
  shield: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  lock: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
  link: "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1",
  globe: "M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  coins: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  vote: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01",
};
---

<section class="py-20 bg-gray-50 dark:bg-gray-800/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        DeFi-Grade Security Features
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        Tesseract implements multiple layers of protection designed specifically
        for cross-chain DeFi operations.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="card-feature group">
          <!-- Icon -->
          <div class={`w-12 h-12 rounded-lg flex items-center justify-center mb-4 ${
            feature.color === 'primary'
              ? 'bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400'
              : 'bg-secondary-100 dark:bg-secondary-900/30 text-secondary-600 dark:text-secondary-400'
          } group-hover:scale-110 transition-transform`}>
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[feature.icon]} />
            </svg>
          </div>

          <!-- Content -->
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
            {feature.title}
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a href="/docs/security" class="inline-flex items-center text-primary-600 dark:text-primary-400 font-medium hover:underline">
        Learn more about our security model
        <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
