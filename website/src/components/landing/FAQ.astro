---
// FAQ Section - Critical for GEO/AI Search Optimization
// Each Q&A is self-contained and extractable

const faqs = [
  {
    question: "What is Tesseract Protocol?",
    answer: "Tesseract is a cross-rollup atomic swap protocol that enables trustless token exchanges across Ethereum L2s using a commit-reveal-resolve pattern. Unlike bridges, Tesseract uses direct swaps without wrapped tokens, providing MEV protection and flash loan resistance.",
  },
  {
    question: "How does Tesseract protect against MEV?",
    answer: "Tesseract uses a commit-reveal scheme where users first submit a cryptographic hash of their transaction. MEV bots cannot see swap details until after the commitment is on-chain, preventing front-running and sandwich attacks entirely.",
  },
  {
    question: "What is the commit-reveal-resolve pattern?",
    answer: "The three-phase pattern works as follows: (1) Commit - user submits transaction hash hiding payload from MEV bots, (2) Reveal - user reveals payload after on-chain confirmation, (3) Resolve - relayers coordinate execution after a 2-block flash loan protection delay.",
  },
  {
    question: "Which networks does Tesseract support?",
    answer: "Tesseract supports 5 networks: Ethereum, Polygon, Arbitrum, Optimism, and Base. Each network uses identical contract code for consistent security. Testnets include Sepolia, Amoy, and network-specific Sepolia variants.",
  },
  {
    question: "What are the fees for using Tesseract?",
    answer: "The default protocol fee is 0.2% per swap. TESS token holders with 10,000+ TESS staked receive a 50% discount (0.1% effective fee). Fees are distributed: 60% to stakers, 30% to relayers, 10% to treasury.",
  },
  {
    question: "How do atomic swap groups work?",
    answer: "Atomic swap groups allow up to 4 swap legs to execute together across chains. If any leg fails, all legs revert automatically. This enables complex strategies like multi-hop arbitrage (ETH→USDC→MATIC→ETH) with guaranteed atomicity.",
  },
  {
    question: "What is the TESS token used for?",
    answer: "TESS is the governance and utility token with 1 billion total supply. Uses include: staking to earn 60% of protocol fees, governance voting on protocol changes, and fee discounts (50% off for 10k+ TESS holders).",
  },
  {
    question: "How does staking work?",
    answer: "Stake a minimum of 1,000 TESS to earn protocol fees. Rewards are non-dilutive (paid in actual swap tokens like ETH/USDC, not TESS). Unstaking requires a 7-day cooldown, or instant withdrawal with a 10% penalty.",
  },
  {
    question: "Is Tesseract audited?",
    answer: "Tesseract's 7 Vyper smart contracts have undergone internal security review with a comprehensive test suite of 135+ tests. External audit is pending before mainnet launch. All contracts are open source on GitHub.",
  },
  {
    question: "How do I integrate Tesseract?",
    answer: "Developers can integrate via smart contract calls to TesseractBuffer (buffering/reveal/resolve) and AtomicSwapCoordinator (order creation/filling). Full API documentation, SDK, and integration guides are available in the developer docs.",
  },
];

// Generate FAQ schema for JSON-LD
const faqSchema = faqs.map(faq => ({
  question: faq.question,
  answer: faq.answer,
}));
---

<section class="py-20 bg-white dark:bg-gray-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Frequently Asked Questions
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        Everything you need to know about Tesseract Protocol.
      </p>
    </div>

    <!-- FAQ Items -->
    <div class="faq-section">
      {faqs.map((faq, index) => (
        <div class="faq-item" data-faq-index={index}>
          <button
            class="faq-question flex items-center justify-between w-full"
            aria-expanded="false"
            data-faq-toggle
          >
            <span class="text-left pr-4">{faq.question}</span>
            <svg class="w-5 h-5 flex-shrink-0 transform transition-transform faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden" data-faq-content>
            <p>{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- More Questions CTA -->
    <div class="text-center mt-12">
      <p class="text-gray-600 dark:text-gray-400 mb-4">
        Still have questions?
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/docs" class="btn-outline">
          Read Documentation
        </a>
        <a href="https://discord.gg/tesseract" class="text-primary-600 dark:text-primary-400 font-medium hover:underline">
          Ask on Discord
        </a>
      </div>
    </div>
  </div>

  <!-- FAQ Schema (for SEO) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqSchema.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />
</section>

<script>
  // FAQ Accordion functionality
  document.querySelectorAll('[data-faq-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const item = button.closest('[data-faq-index]');
      const content = item?.querySelector('[data-faq-content]');
      const icon = item?.querySelector('.faq-icon');
      const isExpanded = button.getAttribute('aria-expanded') === 'true';

      // Close all other FAQs
      document.querySelectorAll('[data-faq-index]').forEach((otherItem) => {
        if (otherItem !== item) {
          const otherButton = otherItem.querySelector('[data-faq-toggle]');
          const otherContent = otherItem.querySelector('[data-faq-content]');
          const otherIcon = otherItem.querySelector('.faq-icon');
          otherButton?.setAttribute('aria-expanded', 'false');
          otherContent?.classList.add('hidden');
          otherIcon?.classList.remove('rotate-180');
        }
      });

      // Toggle current FAQ
      button.setAttribute('aria-expanded', String(!isExpanded));
      content?.classList.toggle('hidden');
      icon?.classList.toggle('rotate-180');
    });
  });
</script>
