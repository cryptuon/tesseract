---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    question: "How does Tesseract compare to Uniswap cross-chain?",
    answer: "Uniswap uses AMM liquidity pools requiring LPs; Tesseract uses direct atomic swaps. Tesseract offers MEV protection via commit-reveal and flash loan resistance via 2-block delay. Uniswap is faster for small swaps but Tesseract is safer for large orders.",
  },
  {
    question: "Does Tesseract have liquidity pools?",
    answer: "No. Tesseract uses an order book model where makers create swap orders and takers fill them. This means no impermanent loss, no LP requirements, and no liquidity fragmentation across chains.",
  },
  {
    question: "Can Tesseract match DEX prices?",
    answer: "Tesseract swap prices are set by makers/takers directly with slippage protection (min_receive_amount). While not using AMM curves, the order book model can offer competitive pricing for larger orders without price impact.",
  },
  {
    question: "Is Tesseract faster than DEXs?",
    answer: "Single-chain DEX swaps are faster (1 block). Tesseract cross-chain swaps take 2-5 minutes due to the commit-reveal-resolve pattern and finality requirements. The tradeoff is superior MEV protection.",
  },
];
---

<BaseLayout
  title="Tesseract vs Cross-Chain DEXs"
  description="Compare Tesseract atomic swaps to cross-chain DEX solutions like Uniswap X and 1inch cross-chain. Learn the differences in MEV protection, liquidity models, and fees."
  keywords={[
    "Tesseract vs Uniswap",
    "Tesseract vs 1inch",
    "cross-chain DEX comparison",
    "atomic swap vs AMM",
    "DEX alternative"
  ]}
  jsonLdType="faq"
  jsonLdData={{ questions: faqs }}
>
  <div class="bg-white dark:bg-gray-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Breadcrumb -->
      <nav class="mb-8 text-sm">
        <ol class="flex items-center gap-2 text-gray-500 dark:text-gray-400">
          <li><a href="/" class="hover:text-primary-600">Home</a></li>
          <li>/</li>
          <li><a href="/compare" class="hover:text-primary-600">Compare</a></li>
          <li>/</li>
          <li class="text-gray-900 dark:text-white">vs DEXs</li>
        </ol>
      </nav>

      <!-- Header -->
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Tesseract vs Cross-Chain DEXs: Complete Comparison
      </h1>

      <!-- Last Updated -->
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-8">
        Last updated: April 15, 2026
      </p>

      <!-- Quick Answer -->
      <div class="quick-answer">
        <p>
          Tesseract differs from cross-chain DEXs by using an order book model instead
          of AMM liquidity pools. Key advantages include MEV protection via commit-reveal
          (DEXs are highly susceptible to MEV), no impermanent loss for liquidity providers,
          and atomic swap groups for multi-leg strategies. The 0.2% fee is lower than most
          cross-chain DEX fees (typically 0.3-1%).
        </p>
      </div>

      <!-- Key Facts -->
      <div class="key-facts">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Key Differences at a Glance</h2>
        <ul>
          <li>Tesseract uses order book; DEXs use AMM liquidity pools</li>
          <li>Tesseract has commit-reveal MEV protection; DEXs are MEV targets</li>
          <li>Tesseract has no impermanent loss; DEX LPs face IL risk</li>
          <li>Tesseract supports 4-leg atomic groups; DEXs don't</li>
          <li>Tesseract fees (0.2%) are lower than most cross-chain DEXs (0.3-1%)</li>
        </ul>
      </div>

      <!-- Comparison Table -->
      <section class="my-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
          Feature Comparison Table
        </h2>

        <div class="overflow-x-auto">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Feature</th>
                <th class="bg-primary-50 dark:bg-primary-900/30">Tesseract</th>
                <th>Uniswap X</th>
                <th>1inch Cross-Chain</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="font-medium text-gray-900 dark:text-white">Model</td>
                <td class="bg-primary-50/50 dark:bg-primary-900/20">Order Book</td>
                <td>RFQ + AMM</td>
                <td>Aggregator + Bridges</td>
              </tr>
              <tr>
                <td class="font-medium text-gray-900 dark:text-white">MEV Protection</td>
                <td class="bg-primary-50/50 dark:bg-primary-900/20 text-green-600 dark:text-green-400 font-medium">Commit-Reveal</td>
                <td>Partial (Dutch Auction)</td>
                <td class="text-red-600 dark:text-red-400">Limited</td>
              </tr>
              <tr>
                <td class="font-medium text-gray-900 dark:text-white">Flash Loan Resistant</td>
                <td class="bg-primary-50/50 dark:bg-primary-900/20 text-green-600 dark:text-green-400 font-medium">2-Block Delay</td>
                <td class="text-red-600 dark:text-red-400">No</td>
                <td class="text-red-600 dark:text-red-400">No</td>
              </tr>
              <tr>
                <td class="font-medium text-gray-900 dark:text-white">Impermanent Loss</td>
                <td class="bg-primary-50/50 dark:bg-primary-900/20 text-green-600 dark:text-green-400 font-medium">None</td>
                <td class="text-red-600 dark:text-red-400">Yes (LPs)</td>
                <td>Depends on route</td>
              </tr>
              <tr>
                <td class="font-medium text-gray-900 dark:text-white">Atomic Groups</td>
                <td class="bg-primary-50/50 dark:bg-primary-900/20 text-green-600 dark:text-green-400 font-medium">Up to 4 Legs</td>
                <td class="text-red-600 dark:text-red-400">No</td>
                <td class="text-red-600 dark:text-red-400">No</td>
              </tr>
              <tr>
                <td class="font-medium text-gray-900 dark:text-white">Typical Fees</td>
                <td class="bg-primary-50/50 dark:bg-primary-900/20">0.2%</td>
                <td>0.3%+</td>
                <td>0.3-1%</td>
              </tr>
              <tr>
                <td class="font-medium text-gray-900 dark:text-white">Slippage</td>
                <td class="bg-primary-50/50 dark:bg-primary-900/20">min_receive_amount</td>
                <td>Price impact + slippage</td>
                <td>Aggregated slippage</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Detailed Sections -->
      <section class="prose prose-gray dark:prose-invert max-w-none">
        <h2>How Does Tesseract Differ from DEXs?</h2>

        <p>
          The core difference is the trading model: DEXs use Automated Market Makers (AMMs)
          with liquidity pools, while Tesseract uses an order book where users create
          and fill discrete swap orders.
        </p>

        <h3>DEX Model (AMM)</h3>
        <ul>
          <li>Liquidity providers deposit token pairs into pools</li>
          <li>Pricing determined by constant product formula (x * y = k)</li>
          <li>Large trades face significant price impact</li>
          <li>LPs earn fees but face impermanent loss risk</li>
          <li>Highly susceptible to MEV extraction</li>
        </ul>

        <h3>Tesseract Model (Order Book)</h3>
        <ul>
          <li>Makers create swap orders with specific prices</li>
          <li>Takers fill orders at the stated price</li>
          <li>No price impact for orders within liquidity</li>
          <li>No impermanent loss (no LP role)</li>
          <li>MEV protected via commit-reveal</li>
        </ul>

        <h2>When Should I Use Tesseract vs a DEX?</h2>

        <p><strong>Use Tesseract when:</strong></p>
        <ul>
          <li>Making large cross-chain swaps (no price impact)</li>
          <li>MEV protection is critical (hidden order flow)</li>
          <li>Executing multi-leg strategies (arbitrage, rebalancing)</li>
          <li>You want predictable pricing (order book, not AMM curve)</li>
        </ul>

        <p><strong>Use a DEX when:</strong></p>
        <ul>
          <li>Small single-chain swaps (faster, simpler)</li>
          <li>You need immediate execution (no commit-reveal delay)</li>
          <li>Trading popular pairs with deep liquidity</li>
          <li>You want to LP and earn trading fees</li>
        </ul>
      </section>

      <!-- FAQ Section -->
      <section class="mt-16">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
          Frequently Asked Questions
        </h2>

        <div class="faq-section">
          {faqs.map((faq, index) => (
            <div class="faq-item" data-faq-index={index}>
              <button
                class="faq-question flex items-center justify-between w-full"
                aria-expanded="false"
                data-faq-toggle
              >
                <span class="text-left pr-4">{faq.question}</span>
                <svg class="w-5 h-5 flex-shrink-0 transform transition-transform faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-answer hidden" data-faq-content>
                <p>{faq.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="mt-16 bg-primary-50 dark:bg-primary-900/20 rounded-2xl p-8 text-center">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
          Experience the Difference
        </h2>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
          Try Tesseract's order book model with MEV protection.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/dashboard" class="btn-primary">
            Launch Dashboard
          </a>
          <a href="/compare/vs-bridges" class="btn-outline">
            Compare to Bridges
          </a>
        </div>
      </section>
    </div>
  </div>

  <script>
    document.querySelectorAll('[data-faq-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const item = button.closest('[data-faq-index]');
        const content = item?.querySelector('[data-faq-content]');
        const icon = item?.querySelector('.faq-icon');
        const isExpanded = button.getAttribute('aria-expanded') === 'true';

        document.querySelectorAll('[data-faq-index]').forEach((otherItem) => {
          if (otherItem !== item) {
            const otherButton = otherItem.querySelector('[data-faq-toggle]');
            const otherContent = otherItem.querySelector('[data-faq-content]');
            const otherIcon = otherItem.querySelector('.faq-icon');
            otherButton?.setAttribute('aria-expanded', 'false');
            otherContent?.classList.add('hidden');
            otherIcon?.classList.remove('rotate-180');
          }
        });

        button.setAttribute('aria-expanded', String(!isExpanded));
        content?.classList.toggle('hidden');
        icon?.classList.toggle('rotate-180');
      });
    });
  </script>
</BaseLayout>
